# Copia in .env per lo sviluppo locale (non committare .env)

# Lasciando file:local.db si usa uno SQLite locale, senza Turso
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Hash generato con: python auth.py <la-tua-password>
APP_USER=admin
APP_PASSWORD_HASH=
JWT_SECRET=cambiami

CORS_ORIGINS=http://localhost:4200
